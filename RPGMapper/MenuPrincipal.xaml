<Window x:Class="RPGMapper.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGMapper"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        WindowStyle="ToolWindow"
        Title="RPG Mapper" Height="500" Width="600"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Window.Resources>
        <SolidColorBrush x:Key="WoodDark" Color="#4A2F1B"/>
        <SolidColorBrush x:Key="Wood" Color="#8B5A2B"/>
        <SolidColorBrush x:Key="Parchment" Color="#E8D3A5"/>
        <SolidColorBrush x:Key="Ink" Color="#3A2514"/>
        <SolidColorBrush x:Key="Gold" Color="#C49A45"/>
        <SolidColorBrush x:Key="Panel" Color="#D6BC8B"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#4B2A17"/>

            <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextElement.Foreground="{TemplateBinding Foreground}"/>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#A36A2B"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#6A3515"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="\assets\Madeira.jpg" Stretch="Fill"/>
        </Grid.Background>
        <Border Margin="10">
            <Border.Background>
                <ImageBrush ImageSource="/assets/Pergaminho.jpg" Stretch="Fill"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                  ShadowDepth="3"
                  Direction="315"
                  Color="Black"
                  Opacity="0.7"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock
                    Margin="0,30,0,0"
                    Text="══════════════════════════ ✦ ══════════════════════════"
                    FontSize="18"
                    Foreground="#6A4324"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="RPG Mapper"
                    FontSize="75"
                    FontWeight="Bold"
                    FontFamily="Georgia"
                    Foreground="#4A2D14"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="══════════════════════════ ✦ ══════════════════════════"
                    FontSize="18"
                    Foreground="#6A4324"
                    HorizontalAlignment="Center"/>

                <Button Name="EntrarButton" Click="EntrarSala_Click" Style="{StaticResource MenuButtonStyle}">

                    <TextBlock
                        Margin="0,20,0,20"
                        Text="❧ Entrar em uma sala"
                        FontSize="28"
                        FontFamily="Segoe Script"/>

                </Button>

                <Button x:Name="CriarButton" Click="CriarSala_Click" Style="{StaticResource MenuButtonStyle}">

                    <TextBlock
                        Margin="0,20,0,20"
                        Text="❧ Criar sala"
                        FontSize="28"
                        FontFamily="Segoe Script"/>

                </Button>

                <Button x:Name="EditarButton" Click="EditarMapas_Click" Style="{StaticResource MenuButtonStyle}">

                    <TextBlock
                        Margin="0,20,0,20"
                        Text="❧ Editar Mapa"
                        FontSize="28"
                        FontFamily="Segoe Script"/>

                </Button>
            </StackPanel>
        </Border>

        <Grid Name="ProcurarSala" Height="200" Width="300" Visibility="Collapsed">
            <Border BorderBrush="{StaticResource WoodDark}" BorderThickness="2" Background="#D6BC8B">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                      ShadowDepth="3"
                      Direction="315"
                      Color="Black"
                      Opacity="0.7"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Procurar sala" FontFamily="Georgia" Foreground="#6A4324" HorizontalAlignment="Center" FontSize="30" FontWeight="Black" Margin="10"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nome de usuário:" FontFamily="Georgia" FontSize="12" Margin="10"/>
                        <TextBox Name="UserName_TextBox" Width="150" Height="20" FontFamily="Georgia" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Código da sala:" FontFamily="Georgia" FontSize="12" Margin="10"/>
                        <TextBox PreviewTextInput="RoomCode_TextBox_PreviewTextInput" 
                                 MaxLength="6" Name="RoomCode_TextBox"
                                 Width="150" Height="20"
                                 FontFamily="Georgia" FontSize="12"
                                 Margin="16,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="25">
                        <Button Click="Cancelar_click"
                                Content="Cancelar"
                                Height="30" Width="100"
                                Background="{StaticResource Wood}"
                                BorderBrush="{StaticResource WoodDark}"
                                BorderThickness="2"
                                FontFamily="Georgia"
                                FontSize="12"
                                Cursor="Hand"/>
                        
                        <Button Click="Procurar_Click"
                                Content="Procurar"
                                Height="30" Width="100"
                                Margin="45,0,0,0"
                                Background="{StaticResource Wood}"
                                BorderBrush="{StaticResource WoodDark}"
                                BorderThickness="2"
                                FontFamily="Georgia"
                                FontSize="12"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>

</Window>
