<Window x:Class="RPGMapper.Sala"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGMapper"
        mc:Ignorable="d"
        Title="Sala" Height="800" Width="800"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="WoodDark" Color="#4A2F1B"/>
        <SolidColorBrush x:Key="Wood" Color="#8B5A2B"/>
        <SolidColorBrush x:Key="Parchment" Color="#E8D3A5"/>
        <SolidColorBrush x:Key="Ink" Color="#3A2514"/>
        <SolidColorBrush x:Key="Gold" Color="#C49A45"/>
        <SolidColorBrush x:Key="Panel" Color="#D6BC8B"/>
    </Window.Resources>
    
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/assets/Pergaminho.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Height="50">
            <Border.Background>
                <ImageBrush ImageSource="/assets/Madeira.jpg"/>
            </Border.Background>
        </Border>
        <Border Grid.Row="0" Grid.Column="3" VerticalAlignment="Top" Height="50">
            <Border.Background>
                <ImageBrush ImageSource="/assets/Madeira.jpg"/>
            </Border.Background>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource Panel}" VerticalAlignment="Top" Height="75" CornerRadius="0,0,5,5" BorderThickness="4">
            <Border.BorderBrush>
                <ImageBrush ImageSource="/assets/Madeira.jpg"/>
            </Border.BorderBrush>

            <TextBlock Text="Taverna" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontFamily="/assets/fonts/#Uncial Antiqua" Foreground="{StaticResource Ink}"/>
        </Border>

        <Border Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="25,35,15,25"
                Padding="25"
                Background="#D6BC8B"
                BorderBrush="{StaticResource WoodDark}"
                BorderThickness="3"
                CornerRadius="10">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    ShadowDepth="3"
                    Opacity="0.3"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->

                <TextBlock
                    Text="Aventureiros"
                    FontFamily="/assets/fonts/#Uncial Antiqua"
                    FontSize="32"
                    Foreground="{StaticResource Ink}"
                    HorizontalAlignment="Center"/>

                <!-- Jogadores -->

                <ScrollViewer Grid.Row="1"
                              Margin="10,20">

                    <Grid>
                        <ItemsControl ItemsSource="{Binding JogadoresTemp}">
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                    <Border
                                        Background="#20FFFFFF"
                                        BorderBrush="#806B4324"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,5">   

                                        <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding .}"
                                                FontFamily="Georgia"
                                                FontSize="18"
                                                Foreground="{StaticResource Ink}"
                                                VerticalAlignment="Center"/>
                                        </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Quantidade -->

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="{Binding JogadoresTemp.Count}"
                            FontFamily="Georgia"
                            FontSize="15"
                            Foreground="#66452A"/>
                    <TextBlock
                            Text=" / 6 aventureiros"
                            FontFamily="Georgia"
                            FontSize="15"
                            Foreground="#66452A"/>
                </StackPanel>
            </Grid>

        </Border>

        <Border Name="MestreHud"
                Grid.Column="2"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="15,35,25,25"
                Padding="25"
                Background="#D6BC8B"
                BorderBrush="{StaticResource WoodDark}"
                BorderThickness="3"
                CornerRadius="10"
                Visibility="Collapsed">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Text="Mestre"
                    FontFamily="/assets/fonts/#Uncial Antiqua"
                    FontSize="32"
                    Foreground="{StaticResource Ink}"
                    HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="1"
                    Margin="10,25">

                    <TextBlock
                        Text="Mapa da aventura"
                        FontFamily="Georgia"
                        FontSize="18"
                        Foreground="{StaticResource Ink}"
                        HorizontalAlignment="Center"/>

                    <!-- Prévia do mapa -->

                    <Border
                        Width="250"
                        Height="180"
                        Margin="0,15"
                        Background="#332218"
                        BorderBrush="{StaticResource WoodDark}"
                        BorderThickness="3"
                        CornerRadius="5">

                        <Grid>

                            <Image Name="ImagemMapa" Source="{Binding Imagem}"/>

                        </Grid>

                    </Border>

                    <Button
                        Click="EscolherMapa_Click"
                        Content="Escolher mapa"
                        Width="180"
                        Height="40"
                        Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <TextBlock
                            Text="Código da sala:"
                            FontFamily="Georgia"
                            FontSize="18"
                            Foreground="{StaticResource Ink}"
                            HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding Codigo}"
                                   Margin="10,0,0,0"
                                   FontFamily="Georgia"
                                   FontSize="18"
                                   Foreground="{StaticResource Ink}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button
                    Click="ComecarJogo_Click"
                    Grid.Row="2"
                    Content="✦  COMEÇAR AVENTURA  ✦"
                    Width="240"
                    Height="50"
                    Background="{StaticResource Gold}"
                    Foreground="{StaticResource Ink}"
                    BorderBrush="{StaticResource WoodDark}"
                    BorderThickness="2"
                    FontFamily="Georgia"
                    FontWeight="Bold"
                    FontSize="16"/>

            </Grid>

        </Border>

        <Button
            Click="SairSala_Click"
            Grid.Row="2"
            Grid.Column="0"
            Content="Sair da sala"
            Width="140"
            Height="35"
            HorizontalAlignment="Center"
            Background="{StaticResource Wood}"
            BorderBrush="{StaticResource WoodDark}"
            BorderThickness="2"
            FontFamily="Georgia"
            FontSize="24"
            Cursor="Hand"/> 

        <Image Grid.Row="3" Grid.ColumnSpan="4" Source="/assets/Madeira.jpg" Stretch="Fill"/>
    </Grid>
</Window>
