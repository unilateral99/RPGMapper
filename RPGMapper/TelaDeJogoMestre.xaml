<Window x:Class="RPGMapper.TelaDeJogoMestre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGMapper"
        xmlns:conv="clr-namespace:RPGMapper.Conversores"
        mc:Ignorable="d"
        Title="Tela De Jogo - Mestre" Height="800" Width="800"
        Closed="Window_Closed">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Delete" Executed="Delete_Executed" CanExecute="Delete_CanExecute"/>
    </Window.CommandBindings>
    
    <Window.Resources>
        <conv:ZoomPercentageConverter x:Key="ZoomConverter"/>

        <Style x:Key="SimpleToolBar" TargetType="ToolBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="2">

                            <ToolBarPanel IsItemsHost="True"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="WoodDark" Color="#4A2F1B"/>
        <SolidColorBrush x:Key="Wood" Color="#8B5A2B"/>
        <SolidColorBrush x:Key="Parchment" Color="#E8D3A5"/>
        <SolidColorBrush x:Key="Ink" Color="#3A2514"/>
        <SolidColorBrush x:Key="Gold" Color="#C49A45"/>
        <SolidColorBrush x:Key="Panel" Color="#D6BC8B"/>
    </Window.Resources>

    <Grid PreviewMouseWheel="MainGrid_PreviewMouseWheel" Name="MainGrid" Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200" MinHeight="60" MaxHeight="500"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="200" MinWidth="60" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- GridSplitters -->
        <GridSplitter Background="Transparent" Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <GridSplitter Background="Transparent" Grid.Column="1" Grid.RowSpan="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Seletor de mapas -->
        <TabControl SelectionChanged="tabControlMaps_SelectionChanged"  x:Name="tabControlMaps" Grid.Row="0" Background="{StaticResource Wood}" ItemsSource="{Binding Grades}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nome}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>

                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <ToolBarTray Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsLocked="True" Background="{StaticResource Parchment}" ToolBar.OverflowMode="Never" Margin="5">
            <ToolBar Background="{StaticResource Parchment}" Style="{StaticResource SimpleToolBar}" ToolBar.OverflowMode="Never">
                <ComboBox SelectionChanged="ResetarCbb"  Name="CbbInimigo" ItemsSource="{Binding Inimigos}" Width="100" SelectedItem="{Binding inimigoSelecionado, Mode=OneWayToSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                <TextBlock Text="{Binding Nome}" Width="60" Height="20"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox SelectionChanged="ResetarCbb" Name="CbbJogador" ItemsSource="{Binding Jogadores}" Width="100" SelectedItem="{Binding jogadorSelecionado, Mode=OneWayToSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                <TextBlock Text="{Binding Nome}" Width="75" Height="20"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox SelectionChanged="ResetarCbb" Name="CbbNpc" ItemsSource="{Binding Npcs}" Width="100" SelectedItem="{Binding npcSelecionado, Mode=OneWayToSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                <TextBlock Text="{Binding Nome}" Width="75" Height="20"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox SelectionChanged="ResetarCbb" Name="CbbEvento" ItemsSource="{Binding Eventos}" Width="100" SelectedItem="{Binding eventoSelecionado, Mode=OneWayToSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                <TextBlock Text="{Binding Nome}" Width="75" Height="20"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>
            
            
        
        <!-- Lista de jogadores-->
        <Border Grid.Column="2" Grid.RowSpan="4" BorderBrush="{StaticResource WoodDark}" BorderThickness="2">
            <Border.Background>
                <ImageBrush ImageSource="/assets/Madeira.jpg"/>
            </Border.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Margin="5" BorderBrush="{StaticResource Panel}" BorderThickness="2">
                        <Border.Background>
                            <ImageBrush ImageSource="/assets/Pergaminho.jpg"/>
                        </Border.Background>

                        <TextBlock Text="Jogadores" HorizontalAlignment="Center" FontSize="20" FontWeight="Black" FontFamily="Georgia"/>
                    </Border>

                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding JogadoresPlayer}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" BorderBrush="{StaticResource Panel}" BorderThickness="2">

                                        <Border.Background>
                                            <ImageBrush ImageSource="/assets/Pergaminho.jpg"/>
                                        </Border.Background>

                                        <StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="Bold" Margin="5,5,0,0" FontFamily="Georgia"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NomeJogador}" FontSize="16" Margin="5"/>
                                                <Button Click="LimparJogador_Click" Content="✕" Foreground="Wheat" BorderBrush="DarkRed" Background="Red" Height="20" Width="20" Margin="5"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
        </Border>

        <!-- Chat e outros -->
        <Border BorderBrush="{StaticResource WoodDark}" BorderThickness="2" Grid.Row="4" Grid.ColumnSpan="3">

            <Border.Background>
                <ImageBrush ImageSource="/assets/Madeira.jpg"/>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Grid Name="ChatGrid" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid.Background>
                        <ImageBrush ImageSource="/assets/Pergaminho.jpg"/>
                    </Grid.Background>

                    <TextBlock Text="Chat: " FontFamily="Segoe Script" FontSize="20" Margin="5" FontWeight="Bold"/>
                    <ScrollViewer x:Name="Chat_ScrollViewer" ScrollChanged="Chat_ScrollViewer_ScrollChanged" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Mensagens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0">
                                            <TextBlock Text="{Binding NomeJogador}" FontFamily="Georgia" FontSize="15" Foreground="Black"/>
                                            <TextBlock Text="{Binding Texto}" Margin="10,0,0,0" FontFamily="Segoe Script" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enviar: " FontFamily="Segoe Script" FontSize="20" Margin="5" FontWeight="Bold"/>
                        <TextBox Name="Mensagem_TextBox"
                             KeyDown="Mensagem_KeyDown"
                             Grid.Column="1"
                             BorderBrush="{StaticResource Panel}"
                             Background="{StaticResource Parchment}"
                             Height="30" HorizontalAlignment="Stretch"
                             FontFamily="Segoe Script"
                             FontSize="16"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Button Click="Button_Click" Height="50" Width="150" Margin="10" Background="{StaticResource Wood}" BorderBrush="{StaticResource WoodDark}" Foreground="White" Content="Sair da sala" FontFamily="Georgia" FontSize="20"/>

                    <StatusBar Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource WoodDark}" BorderThickness="1">
                        <StatusBarItem>
                            <Label Content="Zoom: "/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <Slider Name="ZoomSlider" DataContext="{Binding MapaAtual}" Minimum="0.5" Maximum="2.5" Width="100" TickPlacement="BottomRight" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Zoom, Mode=TwoWay}"/>
                        </StatusBarItem>
                    </StatusBar>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tela de jogo -->
        <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="GradeGrid" Width="{Binding MapaAtual.LarguraGrade}" Height="{Binding MapaAtual.AlturaGrade}">
                <Image Source="{Binding MapaAtual.Imagem}" Stretch="Fill"/>

                <ItemsControl Name="GradeIC" ItemsSource="{Binding MapaAtual.Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Name="uniformGrid_main" Columns="{Binding MapaAtual.Largura}" Rows="{Binding MapaAtual.Altura}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Name="GridEntidades" MouseDown="GridEntidades_MouseDown" MouseMove="GridEntidades_MouseMove" MouseUp="GridEntidades_MouseUp">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="ApplicationCommands.Delete"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Header="Deletar"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock/>
                                <Ellipse Name="EntidadeImagem" DataContext="{Binding Entidade}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Imagem}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border BorderBrush="#554433"
                                        BorderThickness="0.5"
                                        Opacity="0.5"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <Grid Grid.RowSpan="4" Grid.Column="0" Name="EnemyViewer" Visibility="Collapsed">
            <Canvas>
                <Border Height="600" Width="300" Canvas.Bottom="75" Canvas.Left="2" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="3"
                                  Direction="315"
                                  Color="Black"
                                  Opacity="0.7"/>
                    </Border.Effect>

                    <Border.Background>
                        <ImageBrush ImageSource="/assets/Pergaminho.jpg"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <ImageBrush ImageSource="/assets/Madeira.jpg"/>
                    </Border.BorderBrush>

                    <Canvas>
                        <Border Background="Black" Width="250" Height="250" Canvas.Left="20" Canvas.Top="20">
                            <Image Source="{Binding Imagem}"/>
                        </Border>
                        <TextBlock Text="{Binding Nome}" TextWrapping="Wrap" FontSize="30" TextAlignment="Center" Width="250" Height="100" Canvas.Left="20" Canvas.Top="300"/>
                        <Border Width="250" Height="50" Background="Red" Canvas.Left="20" Canvas.Bottom="150" BorderBrush="DarkRed" BorderThickness="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Vida:" Foreground="White" FontSize="20" Margin="5,5" Width="50"/>
                                <TextBox Text="{Binding VidaAtual}" Foreground="White" FontSize="20" Height="30" Width="50" Background="DarkRed"/>
                                <Label Content="/" Foreground="White" FontSize="20"/>
                                <TextBlock Text="{Binding Vida}" Foreground="White" FontSize="20" Height="30" Width="50" Background="Red"/>
                            </StackPanel>
                        </Border>

                        <Button Click="FecharEnemyViewer" Content="Fechar" Height="30" Width="200" Canvas.Bottom="10" Canvas.Right="20"/>
                        <Button Click="DeletarInimigo" Width="30" Height="30" Background="DarkRed" BorderBrush="Black" BorderThickness="2" Canvas.Bottom="10" Canvas.Left="20">
                            <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                          Fill="Red" 
                          Stretch="Uniform" 
                          Width="20" Height="20"/>
                        </Button>
                    </Canvas>
                </Border>
            </Canvas>
        </Grid>

    </Grid>

</Window>
