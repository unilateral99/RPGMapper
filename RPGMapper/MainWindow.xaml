<Window x:Class="RPGMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGMapper"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="800" Width="800">
    <Grid>
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                <ToolBar>
                    <Button Content="Novo"/>
                    <Button Content="Abrir"/>
                    <Button Content="Salvar"/>
                    <Separator/>

                    <Label Content="Tamanho: "/>
                    <TextBox Name="txtBox_Largura" Text="100" Width="40" ToolTip="Largura em Tiles"/>
                    <Label Content="x"/>
                    <TextBox Name="txtBox_Altura" Text="100" Width="40" ToolTip="Altura em Tiles"/>
                </ToolBar>
            </ToolBarTray>

            <ToolBarTray DockPanel.Dock="Right" Orientation="Vertical" IsLocked="True">
                <ToolBar>
                    <Button Content="Teste"/>
                </ToolBar>
            </ToolBarTray>

        </DockPanel>
    </Grid>
</Window>
