<Window x:Class="RPGMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGMapper"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="800" Width="800"
        xmlns:conv="clr-namespace:RPGMapper.Conversores"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="Novo_Executed" CanExecute="Novo_CanExecute"/>
        <CommandBinding Command="local:MyCommands.Inimigo" Executed="Inimigo_Executed" CanExecute="Adicionar_CanExecute"/>
        <CommandBinding Command="local:MyCommands.Jogador" Executed="Jogador_Executed" CanExecute="Adicionar_CanExecute"/>
        <CommandBinding Command="local:MyCommands.Npc" Executed="Npc_Executed" CanExecute="Adicionar_CanExecute"/>
        <CommandBinding Command="local:MyCommands.Mapa" Executed="Mapa_Executed" CanExecute="Adicionar_CanExecute"/>
        <CommandBinding Command="local:MyCommands.Imagem" Executed="Imagem_Executed" CanExecute="Imagem_CanExecute"/>
        <CommandBinding Command="local:MyCommands.AdicionarEntidade" Executed="AdicionarEntidade_Executed" CanExecute="AdicionarEntidade_CanExecute"/>
        <CommandBinding Command="local:MyCommands.CancelarEntidade" Executed="CancelarEntidade_Executed" CanExecute="CancelarEntidade_CanExecute"/>
    </Window.CommandBindings>
    
    <Window.Resources>
        <conv:ZoomPercentageConverter x:Key="ZoomConverter"/>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainGrid" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <MenuItem Header="Arquivo">
                    <MenuItem Command="ApplicationCommands.New" Header="Novo"/>
                    <MenuItem Header="Abrir"/>
                    <MenuItem Header="Salvar"/>
                </MenuItem>

                <MenuItem Header="Adicionar">
                    <MenuItem Command="local:MyCommands.Inimigo" Header="Inimigo"/>
                    <MenuItem Command="local:MyCommands.Jogador" Header="Jogador"/>
                    <MenuItem Command="local:MyCommands.Npc" Header="Npc"/>
                    <MenuItem Command="local:MyCommands.Mapa"/>
                </MenuItem>
            </Menu>

            <TabControl SelectionChanged="tabControlMaps_SelectionChanged" x:Name="tabControlMaps" Grid.Row="2" Background="White" ItemsSource="{Binding grades}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nome}"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <ToolBarTray Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsLocked="True" Background="AntiqueWhite">
                <ToolBar Background="AntiqueWhite">
                    <Label Content="Tamanho: " Background="AntiqueWhite"/>
                    <TextBox Name="txtBox_Largura" Text="{Binding Largura, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="40" ToolTip="Largura em Tiles"/>
                    <Label Content="x" Background="AntiqueWhite"/>
                    <TextBox Name="txtBox_Altura" Text="{Binding Altura, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="40" ToolTip="Altura em Tiles"/>
                    <Separator/>

                    <ComboBox Name="CbbInimigo" ItemsSource="{Binding Inimigos}" Width="100" SelectedItem="{Binding inimigoSelecionado, Mode=OneWayToSource}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                    <TextBlock Text="{Binding Nome}" Width="75" Height="20"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Name="CbbJogador" ItemsSource="{Binding Jogadores}" Width="100" SelectedItem="{Binding jogadorSelecionado, Mode=OneWayToSource}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                    <TextBlock Text="{Binding Nome}" Width="75" Height="20"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Name="CbbNpc" ItemsSource="{Binding Npcs}" Width="100" SelectedItem="{Binding npcSelecionado, Mode=OneWayToSource}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Imagem}" Width="25" Height="20"/>
                                    <TextBlock Text="{Binding Nome}" Width="75" Height="20"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </ToolBar>
            </ToolBarTray>

            <ToolBarTray Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Orientation="Vertical" IsLocked="True" Background="AntiqueWhite">
                <ToolBar Background="AntiqueWhite">
                    <TextBlock Text="Adicionar:" Margin="0,0,0,10" Background="AntiqueWhite"/>
                    <Button Content="Inimigo" Command="local:MyCommands.Inimigo" Background="AntiqueWhite" ToolTip="Cria um molde de um Inimigo que pode ser colocado no mapa.&#10;Aparece na caixa 'Inimigos'."/>
                    <Button Content="Jogador" Command="local:MyCommands.Jogador" Background="AntiqueWhite" ToolTip="Cria um molde de um Jogador que pode ser colocado no mapa&#10;Aparece na caixa 'Jogadores'&#10;Só pode ter um de cada jogador no mapa, e essa será a posição inicial na partida"/>
                    <Button Content="NPC" Command="local:MyCommands.Npc" Background="AntiqueWhite"/>
                    <Button Content="Evento" Background="AntiqueWhite"/>
                    <Button Command="local:MyCommands.Mapa" Content="Mapa" Background="AntiqueWhite"/>
                    <Button Content="Transição" Background="AntiqueWhite"/>
                </ToolBar>
            </ToolBarTray>

            <StatusBar Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2">
                <StatusBarItem>
                    <Label Content="Zoom: "/>
                </StatusBarItem>
                <StatusBarItem>
                    <Slider Name="Slider_Zoom" Minimum="0.5" Maximum="2.5" Width="100" TickPlacement="BottomRight" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Zoom, Mode=TwoWay}" ToolTip="{Binding ElementName=Slider_Zoom, Path=Value, Converter={StaticResource ZoomConverter}}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBox Text="{Binding ElementName=Slider_Zoom, Path=Value, UpdateSourceTrigger=LostFocus, Converter={StaticResource ZoomConverter}, Mode=TwoWay}" Width="50"/>
                </StatusBarItem>
            </StatusBar>

            <ScrollViewer PreviewMouseWheel="PreviewMouseWheel_ScrollViewer" Grid.Column="0" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Black">
                <Grid x:Name="GradeGrid" Width="{Binding LarguraGrade}" Height="{Binding AlturaGrade}">

                    <Button Command="ApplicationCommands.New" Content="Abrir imagem" Width="100" Height="30"/>
                    <Image Source="{Binding Imagem}" Stretch="Fill"/>

                    <ItemsControl Name="gradeIC">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Name="uniformGrid_main" Columns="{Binding Largura}" Rows="{Binding Altura}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MouseDown="Tile_Click">
                                    <TextBlock/>
                                    <Image Name="EntidadeImagem" MouseMove="EntidadeImagem_MouseMove" MouseUp="EntidadeImagem_MouseUp"  DataContext="{Binding Entidade}" Source="{Binding Imagem}"/>
                                    <Border BorderBrush="Black" BorderThickness="0.20"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EnemyEditor" Visibility="Collapsed">
            <Border Background="SandyBrown" BorderBrush="SaddleBrown" BorderThickness="5" Width="400" Height="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="3"
                                      Direction="315"
                                      Color="Black"
                                      Opacity="0.7"/>
                </Border.Effect>

                <Canvas>
                    <Border Background="Black" BorderBrush="LightGray" BorderThickness="2" Height="175" Width="175" Canvas.Top="20" Canvas.Left="20">
                        <Image Source="{Binding Imagem}"/>
                    </Border>

                    <Button Command="local:MyCommands.Imagem" Content="Enviar Imagem" Height="30" Width="150" Canvas.Right="20" Canvas.Top="150"/>

                    <TextBlock Text="Nome:" Margin="30" FontSize="20" Canvas.Top="200"/>
                    <TextBox Text="{Binding Nome}" FontSize="20" Width="250" Canvas.Top="230" Canvas.Right="20"/>

                    <TextBlock Text="Vida:" Margin="30" FontSize="20" Canvas.Top="250"/>
                    <TextBox Text="{Binding Vida, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Width="250" Canvas.Top="280" Canvas.Right="20"/>

                    <Button Command="local:MyCommands.AdicionarEntidade" Content="Adicionar" Width="150" Height="30" Canvas.Bottom="20" Canvas.Right="20"/>
                    <Button Command="local:MyCommands.CancelarEntidade" Content="Cancelar" Width="150" Height="30" Canvas.Bottom="20" Canvas.Left="20"/>
                </Canvas>
            </Border>
        </Grid>

        <Grid x:Name="PlayerNpcEditor" Visibility="Collapsed">
            <Border Background="SandyBrown" BorderBrush="SaddleBrown" BorderThickness="5" Width="400" Height="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                              ShadowDepth="3"
                              Direction="315"
                              Color="Black"
                              Opacity="0.7"/>
                </Border.Effect>

                <Canvas>
                    <Border Background="Black" BorderBrush="LightGray" BorderThickness="2" Height="175" Width="175" Canvas.Top="20" Canvas.Left="20">
                        <Image Source="{Binding Imagem}"/>
                    </Border>

                    <Button Command="local:MyCommands.Imagem" Content="Enviar Imagem" Height="30" Width="150" Canvas.Right="20" Canvas.Top="150"/>

                    <TextBlock Text="Nome:" Margin="30" FontSize="20" Canvas.Top="200"/>
                    <TextBox Text="{Binding Nome}" FontSize="20" Width="250" Canvas.Top="230" Canvas.Right="20"/>

                    <Button Command="local:MyCommands.AdicionarEntidade" Content="Adicionar" Width="150" Height="30" Canvas.Bottom="20" Canvas.Right="20"/>
                    <Button Command="local:MyCommands.CancelarEntidade" Content="Cancelar" Width="150" Height="30" Canvas.Bottom="20" Canvas.Left="20"/>
                </Canvas>
            </Border>
        </Grid>
    </Grid>
</Window>
